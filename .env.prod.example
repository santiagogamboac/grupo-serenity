# Producción (www.gruposerenity.com). En el servidor:  cp .env.prod.example .env  y reemplaza TODO lo que dice CAMBIAR.
# Generar secretos:  openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48
# scripts/deploy.sh se niega a desplegar si queda algún "CAMBIAR" en .env.

ASPNETCORE_ENVIRONMENT=Production

# ─── Dominio y HTTPS (Caddy) ───────────────────────────────────────────────────
# Caddy sirve DOMINIO y www.DOMINIO; el canónico es www (DOMINIO redirige a www).
DOMINIO=gruposerenity.com
ACME_EMAIL=CAMBIAR_correo_para_avisos_de_certificados@gruposerenity.com
# Origen público: CORS, regreso desde Wompi, feed .ics para Airbnb y enlaces de los correos.
PUBLIC_ORIGIN=https://www.gruposerenity.com
MEDIA_PUBLIC_BASE=/media

# ─── Secretos ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CAMBIAR_secreto_largo
MINIO_USER=serenity_minio
MINIO_PASSWORD=CAMBIAR_secreto_largo
# Mínimo 32 caracteres.
JWT_KEY=CAMBIAR_secreto_de_48_caracteres_o_mas

# Usuario administrador inicial (solo se crea si no existe ningún usuario). Cambia la clave después de entrar.
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=CAMBIAR@gruposerenity.com
ADMIN_PASSWORD=CAMBIAR_clave_segura

AIRBNB_SYNC_MINUTOS=5

# ─── Reserva directa ───────────────────────────────────────────────────────────
RESERVAS_MINUTOS_RETENCION=30
RESERVAS_MINUTOS_RETENCION_SIN_PAGO=1440

# Wompi — llaves de PRODUCCIÓN (dashboard de Wompi → Desarrolladores). Vacías = pago en línea apagado: las reservas
# quedan apartadas y el equipo las confirma a mano desde /admin/reservas.
# URL de eventos a registrar en Wompi: https://www.gruposerenity.com/api/public/pagos/wompi/eventos
WOMPI_AMBIENTE=produccion
WOMPI_LLAVE_PUBLICA=
WOMPI_LLAVE_PRIVADA=
WOMPI_SECRETO_INTEGRIDAD=
WOMPI_SECRETO_EVENTOS=

# ─── Correo saliente (SMTP real: Google Workspace, Zoho, Brevo, SES…) ─────────
# Vacío = no se envían avisos (las solicitudes y reservas igual quedan en el panel).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_SSL=true
SMTP_USUARIO=
SMTP_PASSWORD=
# Solo la dirección (el nombre visible es "Grupo Serenity").
SMTP_REMITENTE=reservas@gruposerenity.com
# Quién recibe los avisos de solicitudes y reservas (separados por coma).
CORREO_EQUIPO=

# ─── Backups (contenedor `backup`) ─────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_HORA=03:00
BACKUP_RETENCION_DIAS=14

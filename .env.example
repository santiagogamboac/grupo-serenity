# Copia este archivo a .env y cambia los secretos antes de desplegar.
# Generar una clave JWT:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

POSTGRES_PASSWORD=CHANGE_ME
MINIO_USER=serenity_minio
MINIO_PASSWORD=CHANGE_ME
JWT_KEY=CHANGE_ME_min_32_chars

# Usuario administrador inicial (solo se crea si no existe ningún usuario).
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# Puertos publicados en el host (evitan choques con otros proyectos locales).
WEB_PORT=8090
API_PORT=8081
POSTGRES_PORT=5434
MINIO_API_PORT=9012
MINIO_CONSOLE_PORT=9013

# Origen público del sitio (CORS) y base pública de las imágenes.
PUBLIC_ORIGIN=http://localhost:8090
MEDIA_PUBLIC_BASE=/media

# Cada cuántos minutos se descargan los calendarios iCal de los anuncios de Airbnb.
AIRBNB_SYNC_MINUTOS=5

# ─── Reserva directa ───────────────────────────────────────────────────────────
# Minutos que se retienen las fechas mientras el huésped paga (con Wompi) o mientras el equipo cobra (sin Wompi).
RESERVAS_MINUTOS_RETENCION=30
RESERVAS_MINUTOS_RETENCION_SIN_PAGO=1440

# Wompi (dashboard → Desarrolladores). Vacío = pago en línea apagado. Ambiente: sandbox | produccion.
# URL de eventos a registrar en Wompi: <PUBLIC_ORIGIN>/api/public/pagos/wompi/eventos
WOMPI_AMBIENTE=sandbox
WOMPI_LLAVE_PUBLICA=
WOMPI_LLAVE_PRIVADA=
WOMPI_SECRETO_INTEGRIDAD=
WOMPI_SECRETO_EVENTOS=

# Correo saliente. Vacío = no se envían avisos. En desarrollo: SMTP_HOST=mailpit, SMTP_PUERTO=1025, SMTP_SSL=false
# y levantar con `docker compose --profile dev up -d` (bandeja en http://localhost:8027).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_SSL=true
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=
# Quién recibe los avisos de solicitudes y reservas (separados por coma).
CORREO_EQUIPO=

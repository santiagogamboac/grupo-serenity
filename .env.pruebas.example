# Pruebas (segundo stack en la VPS de producción). En el servidor, dentro del clon de pruebas:
#   cp .env.pruebas.example .env   y reemplaza TODO lo que dice CAMBIAR (secretos DISTINTOS a los de producción).
# Generar secretos:  openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48
# scripts/deploy.sh se niega a desplegar si queda algún "CAMBIAR" en .env.

ASPNETCORE_ENVIRONMENT=Production

# Origen público de pruebas (subdominio servido por el proxy de la VPS → WEB_ALIAS:80). Debe ser https://.
PUBLIC_ORIGIN=https://CAMBIAR_pruebas.gruposerenity.com
MEDIA_PUBLIC_BASE=/media

# Red Docker del proxy público de la VPS y alias con el que este `web` aparece en ella (docker-compose.pruebas.yml).
PROXY_RED=edge
WEB_ALIAS=serenity-pruebas-web

# ─── Secretos ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CAMBIAR_secreto_largo
MINIO_USER=serenity_minio
MINIO_PASSWORD=CAMBIAR_secreto_largo
# Mínimo 32 caracteres.
JWT_KEY=CAMBIAR_secreto_de_48_caracteres_o_mas

ADMIN_NOMBRE=Administrador
ADMIN_CORREO=CAMBIAR@gruposerenity.com
ADMIN_PASSWORD=CAMBIAR_clave_segura

AIRBNB_SYNC_MINUTOS=5

# ─── Reserva directa ───────────────────────────────────────────────────────────
RESERVAS_MINUTOS_RETENCION=30
RESERVAS_MINUTOS_RETENCION_SIN_PAGO=1440

# Wompi — llaves de SANDBOX (nunca las de producción en pruebas). Vacías = pago en línea apagado.
# URL de eventos en el dashboard de Wompi (modo sandbox): <PUBLIC_ORIGIN>/api/public/pagos/wompi/eventos
WOMPI_AMBIENTE=sandbox
WOMPI_LLAVE_PUBLICA=
WOMPI_LLAVE_PRIVADA=
WOMPI_SECRETO_INTEGRIDAD=
WOMPI_SECRETO_EVENTOS=

# ─── Correo saliente ───────────────────────────────────────────────────────────
# Vacío = no se envían avisos. Si lo llenas, usa CORREO_EQUIPO de prueba para no mezclar avisos con los reales.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_SSL=true
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=
CORREO_EQUIPO=
